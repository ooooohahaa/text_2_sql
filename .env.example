# 复制为 .env 并填写实际值

# ===== 模型供应商配置（OpenAI 兼容接口）=====
# LLM（用于 SQL 生成）
LLM_BASE_URL=https://api.your-llm-provider.com/v1
LLM_API_KEY=sk-llm-xxx
LLM_MODEL=gpt-4o-mini

# Embedding（用于 GraphRAG 检索，建议与 LLM 分离）
EMBEDDING_BASE_URL=https://api.your-embedding-provider.com/v1
EMBEDDING_API_KEY=sk-embed-xxx
EMBEDDING_MODEL=text-embedding-3-large

# 兼容旧配置（可选）：若未配置 LLM_API_KEY，会回退使用 OPENAI_API_KEY
# OPENAI_API_KEY=sk-legacy-xxx

# MySQL 连接（Text2SQL 执行查询用）
# 格式: mysql+pymysql://用户:密码@主机:端口/数据库?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/DB_SPLAN_00?charset=utf8mb4

# 可选：schema 描述文档路径，默认使用项目根目录的 schema_description_for_graphrag.md
# SCHEMA_DESCRIPTION_PATH=/path/to/schema_description_for_graphrag.md

# ===== GraphRAG 向量持久化（pgvector，可选）=====
# 不配置 PGVECTOR_URL 时，schema 向量索引使用内存存储
# PGVECTOR_URL=postgresql+psycopg://postgres:password@localhost:5432/vector_db
# PGVECTOR_TABLE=schema_embeddings
# PGVECTOR_SCHEMA=public
# 注意：需与 Embedding 模型维度一致（text-embedding-3-large 通常是 3072）
# PGVECTOR_EMBED_DIM=3072

# --testModel 模式下向量检索返回的 schema 片段数量（默认 8）
# TESTMODEL_RETRIEVER_TOP_K=8
#
# 推荐流程：先配置 PGVECTOR_URL，执行
#   python main.py --build-graphrag-only
# 再执行
#   python main.py --testModel "你的问题"
# （testModel 不会重建索引，只从 pgvector 加载已有向量。）

REVIEW_MAX_ROUNDS=3        # 评审不通过最大轮次